# Path to the trained model files (relative to AI/ or absolute)
MODEL_PATH_LOGISTIC=../Ml/model_pipeline.pkl(logistic)
MODEL_PATH_LINEAR_SVM=../Ml/model_pipeline.pkl

# Default model when client does not specify
DEFAULT_MODEL_NAME=logistic_regression

# Legacy single model path (backward compat)
MODEL_PATH=../Ml/model_pipeline.pkl(logistic)

# SQLite database URL
DATABASE_URL=sqlite:///predictions.db

# Maximum allowed tweet input length
MAX_INPUT_LENGTH=10000

# Server configuration
HOST=0.0.0.0
PORT=8000
